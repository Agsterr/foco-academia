# Banco
POSTGRES_DB=academia
POSTGRES_USER=academia
POSTGRES_PASSWORD=troque-esta-senha

# API
JWT_SECRET=gere-uma-chave-segura-com-pelo-menos-32-caracteres
CORS_ORIGINS=https://academia.focodev.com.br,https://www.academia.focodev.com.br,https://instrutor-academia.focodev.com.br

# Frontends (vazio = mesma origem via nginx)
PUBLIC_API_URL=

# HTTP local (produção: nginx na porta 80 com cloudflared host network)
HTTP_PORT=8088

# Cloudflare R2 (vídeos dos exercícios — se omitido, usa disco local)
R2_BUCKET=foco-academia-videos
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://pub-980d61b3528342859e3122c243d2800b.r2.dev

# Cloudflare Tunnel (opcional — ative com: docker compose --profile tunnel up -d)
CLOUDFLARED_TUNNEL_TOKEN=

# App mobile (APK OTA)
APP_RELEASE_DEPLOY_TOKEN=
APP_PUBLIC_URL=https://academia.focodev.com.br
APP_RELEASES_MAX_COUNT=2
SEED_ADMIN_PASSWORD=
SEED_INSTRUTOR_PASSWORD=
SEED_ALUNO_PASSWORD=

# Assinatura do aluno avulso (Google Play). Deixe BILLING_ENFORCE=false até criar
# os produtos no Play Console e colar o JSON da conta de serviço (uma linha).
BILLING_ENFORCE=false
BILLING_TRIAL_DAYS=7
# Em produção a assinatura criada no Play Console é foco_academia_mensal (R$ 19,99/mês, só Brasil).
BILLING_PRODUCT_IDS=foco_academia_mensal
GOOGLE_PLAY_PACKAGE_NAME=com.focodev.academia.aluno
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
